{
  "manifest_version": 3,
  "name": "ThaiTicketMajor Helper",
  "version": "1.1",
  "description": "Auto-navigate and auto-click helper for ThaiTicketMajor.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "https://*.thaiticketmajor.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.thaiticketmajor.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
